rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each student can only read/write their own profile + progress doc.
    match /students/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Anyone logged in can read the shared lesson slide links.
    // Writing is open to any logged-in student for now — tighten this
    // to a specific teacher UID once you know it, e.g.:
    // allow write: if request.auth != null && request.auth.uid == "PASTE_YOUR_UID_HERE";
    match /config/lessonLinks {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Creator Space posts: anyone logged in can read/create,
    // but only the author can delete their own post.
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Gallery: same pattern as posts.
    match /gallery/{itemId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
  }
}
